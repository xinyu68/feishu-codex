{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "outDir": "build/server", "rootDir": "src",
    "esModuleInterop": true, "resolveJsonModule": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
